{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/notes/cse",
      "destination": "/notes#cse",
      "permanent": false
    },
    {
      "source": "/notes/cse/s1",
      "destination": "/notes#cse-s1",
      "permanent": false
    },
    {
      "source": "/notes/cse/s1/maths/:page(\\d+)",
      "destination": "/notes/cse/s1/maths#page-:page",
      "permanent": true
    }
  ]
}
